#!/usr/bin/env bash
# push した内容のレビューを CodeRabbit へ依頼する。
#
# star が 10 未満の public リポジトリは自動レビューの対象外で、
# PR へ明示的に依頼しないとレビューが走らない。
#
# pre-push は push の完了前に走るため、依頼はバックグラウンドに回し、
# リモートの ref が push した SHA に変わってから投げる。
# 依頼に失敗しても push は成功させる。

set -uo pipefail

command -v gh >/dev/null 2>&1 || exit 0

remote_name=$1
empty_sha=0000000000000000000000000000000000000000

while read -r local_ref local_sha remote_ref _remote_sha; do
  [ "$local_sha" = "$empty_sha" ] && continue

  branch=${local_ref#refs/heads/}
  [ "$branch" = "$local_ref" ] && continue

  [ "$(gh pr view "$branch" --json state --jq .state 2>/dev/null)" = OPEN ] || continue
  pr_number=$(gh pr view "$branch" --json number --jq .number)

  (
    for _ in $(seq 1 30); do
      [ "$(git ls-remote "$remote_name" "$remote_ref" | cut -f1)" = "$local_sha" ] && break
      sleep 2
    done
    gh pr comment "$pr_number" --body '@coderabbitai review'
  ) >/dev/null 2>&1 &
done

exit 0
